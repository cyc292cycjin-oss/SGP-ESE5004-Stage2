{
  "commit": "b9be7d0ab788a4151346c098d2e657c7e94a22da",
  "path": "scripts_project/inventory_audit.py",
  "sha256": "081d4996fb58d3425c4d1c09b996a7005d0403e076721ea6f817915e264d20b5",
  "lines": [
    {
      "line": 1,
      "text": "\"\"\"Source-identity audit and a-priori roundoff budgets. No source changes.\"\"\""
    },
    {
      "line": 2,
      "text": "from pathlib import Path"
    },
    {
      "line": 3,
      "text": "from collections import defaultdict"
    },
    {
      "line": 4,
      "text": "from fractions import Fraction"
    },
    {
      "line": 5,
      "text": "import hashlib,json,math"
    },
    {
      "line": 6,
      "text": "import numpy as np"
    },
    {
      "line": 7,
      "text": "from fixed_accounts import validate_exported_accounting"
    },
    {
      "line": 8,
      "text": ""
    },
    {
      "line": 9,
      "text": "FROZEN='7a07a0ec728b7cc4b9b27a4a2461b67c960790750fd45eed6a3705624c8e06cd'"
    },
    {
      "line": 10,
      "text": "def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()"
    },
    {
      "line": 11,
      "text": "def power_two(q):"
    },
    {
      "line": 12,
      "text": "    mantissa,exp=math.frexp(q)"
    },
    {
      "line": 13,
      "text": "    return math.ldexp(1.,exp-1 if mantissa==.5 else exp)"
    },
    {
      "line": 14,
      "text": "def gamma(n):"
    },
    {
      "line": 15,
      "text": "    u=2.**-53"
    },
    {
      "line": 16,
      "text": "    return n*u/(1-n*u)"
    },
    {
      "line": 17,
      "text": ""
    },
    {
      "line": 18,
      "text": "def audit(n,root):"
    },
    {
      "line": 19,
      "text": "    validate_exported_accounting(n)"
    },
    {
      "line": 20,
      "text": "    base=root/'results_project/assembly_v1/final_allocation'"
    },
    {
      "line": 21,
      "text": "    manifest=json.loads((base/'allocation_manifest.json').read_text()); arrays=np.load(base/manifest['arrays_file'])"
    },
    {
      "line": 22,
      "text": "    if sha(base/manifest['arrays_file'])!=manifest['arrays_sha256']:raise ValueError('Allocation bytes changed')"
    },
    {
      "line": 23,
      "text": "    registry=root/'research_inputs/assembly_v1/registry.json'"
    },
    {
      "line": 24,
      "text": "    if sha(registry)!=manifest['input_registry_sha256']:raise ValueError('Registry binding changed')"
    },
    {
      "line": 25,
      "text": "    reconstruction=root/'research_inputs/assembly_v1/sources/BASE_RECONSTRUCTION.json'"
    },
    {
      "line": 26,
      "text": "    source=json.loads(reconstruction.read_text())['selected_rows']"
    },
    {
      "line": 27,
      "text": "    records={r['InputID']:r for r in json.loads(registry.read_text())['records']}"
    },
    {
      "line": 28,
      "text": "    allocations={r['InputID']:r for r in manifest['records']}"
    },
    {
      "line": 29,
      "text": "    grouped=defaultdict(list)"
    },
    {
      "line": 30,
      "text": "    for s,r in n.meta['biomass_obligation_routes'].items():grouped[tuple(sorted(r['buses']))].append(s)"
    },
    {
      "line": 31,
      "text": "    demand=n.get_switchable_as_dense('Load','p_set'); report=[]"
    },
    {
      "line": 32,
      "text": "    for group,(final,stores) in enumerate(grouped.items()):"
    },
    {
      "line": 33,
      "text": "        loadids=n.loads.index[n.loads.bus.isin(final)]"
    },
    {
      "line": 34,
      "text": "        if len(loadids)!=1:raise ValueError('Audited frozen identity expects one node/account load')"
    },
    {
      "line": 35,
      "text": "        key=loadids[0];ident=n.loads.at[key,'source_account_id'];ar=allocations[ident];r=records[ident]"
    },
    {
      "line": 36,
      "text": "        node=key[len(ident)+1:];j=ar['Nodes'].index(node);series=arrays[ar['ArrayKey']][:,j]"
    },
    {
      "line": 37,
      "text": "        annual=float((series*arrays['weights']).sum())"
    },
    {
      "line": 38,
      "text": "        raw=[z for z in source if z['Country']==r['Country'] and z['Account']==r['Account'] and z['Carrier']=='biomass']"
    },
    {
      "line": 39,
      "text": "        total=sum(float(z['MWh']) for z in raw);raw_by_id={z['RowID']:z for z in raw}"
    },
    {
      "line": 40,
      "text": "        recomputed=[]"
    },
    {
      "line": 41,
      "text": "        for s in stores:"
    },
    {
      "line": 42,
      "text": "            route=n.meta['biomass_obligation_routes'][s];z=raw_by_id[route['source_row']]"
    },
    {
      "line": 43,
      "text": "            value=annual*float(z['MWh'])/total"
    },
    {
      "line": 44,
      "text": "            if value!=n.stores.at[s,'e_initial'] or value!=n.stores.at[s,'e_nom'] or value!=route['annual_cap_mwh']:raise ValueError('Stock source-operation chain mismatch: '+s)"
    },
    {
      "line": 45,
      "text": "            recomputed.append(dict(store=s,commodity=route['commodity'],source_row=z['RowID'],base_commodity_mwh=float(z['MWh']),initial_mwh=value))"
    },
    {
      "line": 46,
      "text": "        daily=series.reshape(365,8).mean(axis=1)"
    },
    {
      "line": 47,
      "text": "        if not np.array_equal(daily,demand[key].values):raise ValueError('Daily mean is not the source-derived load: '+key)"
    },
    {
      "line": 48,
      "text": "        req=sum((Fraction(float(q))*Fraction(float(w)) for q,w in zip(demand[key],n.snapshot_weightings.stores)),Fraction(0))"
    },
    {
      "line": 49,
      "text": "        stock=sum((Fraction(float(n.stores.at[s,'e_initial'])) for s in stores),Fraction(0))"
    },
    {
      "line": 50,
      "text": "        # Sequential-sum upper bound (pairwise implementations can be tighter):"
    },
    {
      "line": 51,
      "text": "        # native time weighting+sum: 2*N-1; raw-composition sum, multiply/divide"
    },
    {
      "line": 52,
      "text": "        # and stock sum: 4*K-2; daily mean: 8; daily weighting+sum: 2*T-1."
    },
    {
      "line": 53,
      "text": "        ops=(2*len(series)-1)+(4*len(stores)-2)+8+(2*len(n.snapshots)-1)"
    },
    {
      "line": 54,
      "text": "        magnitude=max(float(stock),float(req),abs(annual))"
    },
    {
      "line": 55,
      "text": "        budget=gamma(ops)*magnitude"
    },
    {
      "line": 56,
      "text": "        if abs(float(req-stock))>budget:raise ValueError('Annual mismatch exceeds pre-solve source rounding bound')"
    },
    {
      "line": 57,
      "text": "        scale=power_two(magnitude)"
    },
    {
      "line": 58,
      "text": "        report.append(dict(group=group,source_account_id=ident,load=key,final_buses=list(final),stores=stores,source_annual_account_mwh=ar['AnnualMWh'],source_node_annual_mwh=annual,"
    },
    {
      "line": 59,
      "text": "            commodity_rows=recomputed,source_composition_total_mwh=total,derived_daily_required_exact=str(req),initial_stocks_exact=str(stock),exact_annual_difference=str(req-stock),"
    },
    {
      "line": 60,
      "text": "            difference_mwh=float(req-stock),relative_difference=float((req-stock)/stock),operation_count_bound=ops,unit_roundoff=2.**-53,original_energy_error_bound_mwh=budget,"
    },
    {
      "line": 61,
      "text": "            original_power_error_bound_mw=budget/float(n.snapshot_weightings.stores.min()),scale=scale,scale_exponent=int(math.log2(scale)),"
    },
    {
      "line": 62,
      "text": "            floating_quantity_changes=0,source_match='EXACT_RECOMPUTATION',bound_fixed_before_solver=True))"
    },
    {
      "line": 63,
      "text": "    result=dict(method='POWER_OF_TWO_FIXED_INVENTORY_SCALING',source_input_sha256=FROZEN,groups=report,group_count=len(report),store_count=sum(len(g['stores']) for g in report),"
    },
    {
      "line": 64,
      "text": "        positive_differences=sum(g['difference_mwh']>0 for g in report),negative_differences=sum(g['difference_mwh']<0 for g in report),max_relative_difference=max(abs(g['relative_difference']) for g in report),"
    },
    {
      "line": 65,
      "text": "        max_energy_error_bound_mwh=max(g['original_energy_error_bound_mwh'] for g in report),source_hashes={'registry':sha(registry),'allocation_manifest':sha(base/'allocation_manifest.json'),'allocation_arrays':sha(base/manifest['arrays_file']),'base_reconstruction':sha(reconstruction)},"
    },
    {
      "line": 66,
      "text": "        distinction='No RHS or scientific quantity is adjusted. Reversible scaling preserves exact infeasibility. Acceptance within a-priori source-operation rounding bounds is finite-precision treatment, not proof of exact feasibility of the original binary64 model.',"
    },
    {
      "line": 67,
      "text": "        bound_formula='gamma_n=n*u/(1-n*u), u=2^-53; n=(2*2920-1)+(4*K-2)+8+(2*365-1). B_E=gamma_n*max(node annual, sum stocks, weighted daily total), B_P=B_E/min(hours). Same conservative bound also covers 365-step state arithmetic. Not derived from solver outcomes or solver tolerance.')"
    },
    {
      "line": 68,
      "text": "    return result"
    },
    {
      "line": 69,
      "text": ""
    },
    {
      "line": 70,
      "text": "def evaluate_block(d,x,budget_mwh,budget_mw,row_names):"
    },
    {
      "line": 71,
      "text": "    \"\"\"Independent original-unit checks; no relative solver tolerance shortcut.\"\"\""
    },
    {
      "line": 72,
      "text": "    from scipy.sparse import csr_matrix"
    },
    {
      "line": 73,
      "text": "    a=csr_matrix((d['data'],d['indices'],d['indptr']),shape=tuple(d['shape']))"
    },
    {
      "line": 74,
      "text": "    # fsum avoids cancellation hidden by ordinary sparse accumulation."
    },
    {
      "line": 75,
      "text": "    value=np.array([math.fsum(float(a.data[j])*float(x[a.indices[j]]) for j in range(a.indptr[i],a.indptr[i+1])) for i in range(a.shape[0])])"
    },
    {
      "line": 76,
      "text": "    lo,hi=d['row_lower'],d['row_upper'];violation=np.maximum(np.maximum(lo-value,value-hi),0.)"
    },
    {
      "line": 77,
      "text": "    budget=np.array([budget_mwh if name.startswith('Store-') and ('-e-' in name or 'energy_balance' in name) else budget_mw for name in row_names])"
    },
    {
      "line": 78,
      "text": "    vviol=np.maximum(np.maximum(d['var_lower']-x,x-d['var_upper']),0.)"
    },
    {
      "line": 79,
      "text": "    # Variable bounds here are free/default nominal lower bounds. Use stricter MW budget."
    },
    {
      "line": 80,
      "text": "    return dict(accepted=bool(np.isfinite(x).all() and np.all(violation<=budget) and np.all(vviol<=budget_mw)),max_original_row_violation=float(violation.max()),max_variable_bound_violation=float(vviol.max()),worst_row=int(d['constraint_labels'][int(violation.argmax())]),energy_budget_mwh=budget_mwh,power_budget_mw=budget_mw)"
    }
  ],
  "warning": "Historical validator assumes old Q and daily-shaped source operations. Do not run it on Scheme A or silently accept its source-roundoff budget as V4. Reuse only verified historical group scales; new binding adapter requires future checks."
}
