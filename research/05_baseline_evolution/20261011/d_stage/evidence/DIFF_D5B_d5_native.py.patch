+def save_basis(lib, b, meta, run, authorization):
+    """Save VBasis/CBasis (int32) after the raw vectors; failures are recorded and never change the run status."""
+    folder = run / 'raw' / 'basis'; folder.mkdir(exist_ok=False); out = {'run_id': authorization['run_id'], 'use': 'SAVED_ONLY_NOT_FOR_WARM_START', 'arrays': {}}
+    f = lib.GRBgetintattrarray; f.argtypes = [C.c_void_p, C.c_char_p, C.c_int, C.c_int, C.c_void_p]; f.restype = C.c_int
+    for name, count in [('VBasis', meta['num_col']), ('CBasis', meta['num_row'])]:
+        try:
+            arr = np.empty(count, dtype=np.int32)
+            for s, e in ranges(count):
+                if time.time() >= authorization['raw_absolute_deadline_epoch']: raise TimeoutError('RAW_ABSOLUTE_DEADLINE')
+                code = f(b.model, name.encode(), s, e - s, arr[s:].ctypes.data_as(C.c_void_p))
+                if code: raise RuntimeError('GRBgetintattrarray native error ' + str(code))
+            p = folder / (name + '.npy'); np.save(p, arr)
+            with p.open('rb') as fh: os.fsync(fh.fileno())
+            out['arrays'][name] = {'status': 'SAVED', 'count': count, 'sha256': sha(p), 'values': {str(k): int(v) for k, v in zip(*np.unique(arr, return_counts=True))}}
+        except Exception as e: out['arrays'][name] = {'status': 'NOT_AVAILABLE', 'error': type(e).__name__ + ': ' + str(e)[:300]}
+    write(folder / 'BASIS_RECEIPT.json', out); return out
+
