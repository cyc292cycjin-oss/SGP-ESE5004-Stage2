          "939: def add_co2_sequestration_limit(n, sns):",
          "940:     co2_stores = n.stores.loc[n.stores.carrier == \"co2 stored\"].index",
          "941: ",
          "942:     if co2_stores.empty:",
          "943:         return",
          "944: ",
          "945:     vars_final_co2_stored = n.model[\"Store-e\"].loc[sns[-1], co2_stores]",
          "946: ",
          "947:     lhs = (1 * vars_final_co2_stored).sum()",
          "948:     rhs = (",
          "949:         n.config[\"sector\"].get(\"co2_sequestration_potential\", 5) * 1e6",
          "950:     )  # TODO change 200 limit (Europe)",
          "951: ",
          "952:     name = \"co2_sequestration_limit\"",
          "953: ",
          "954:     n.model.add_constraints(lhs <= rhs, name=f\"GlobalConstraint-{name}\")",
          "955: ",
          "956: ",
          "957: def set_h2_colors(n):",
          "958:     blue_h2 = n.model[\"Link-p\"].loc[",
          "959:         n.links.index[n.links.index.str.contains(\"blue H2\")]",
          "960:     ]",
          "961: ",
          "962:     pink_h2 = n.model[\"Link-p\"].loc[",
          "963:         n.links.index[n.links.index.str.contains(\"pink H2\")]",
          "964:     ]"
        ]
