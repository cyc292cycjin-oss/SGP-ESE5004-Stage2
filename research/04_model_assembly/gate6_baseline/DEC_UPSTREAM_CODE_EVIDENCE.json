          "1408: def add_co2(n: pypsa.Network, costs: pd.DataFrame, co2_network: bool) -> None:",
          "1409:     \"\"\"",
          "1410:     Add carbon carrier, its networks and storage units",
          "1411: ",
          "1412:     Parameters",
          "1413:     ----------",
          "1414:     n : pypsa.Network",
          "1415:         The PyPSA network to which the carbon carrier, its networks and storage units will be added.",
          "1416:     costs : pd.DataFrame",
          "1417:         DataFrame containing the costs for the carbon carrier, its networks and storage units.",
          "1418:     co2_network : bool",
          "1419:         Whether to add CO2 network components.",
          "1420: ",
          "1421:     Returns",
          "1422:     -------",
          "1423:     None",
          "1424:     \"\"\"",
          "1425: ",
          "1426:     # minus sign because opposite to how fossil fuels used:",
          "1427:     # CH4 burning puts CH4 down, atmosphere up",
          "1428:     n.add(\"Carrier\", \"co2\", co2_emissions=-1.0)",
          "1429: ",
          "1430:     # this tracks CO2 in the atmosphere",
          "1431:     n.add(",
          "1432:         \"Bus\",",
          "1433:         \"co2 atmosphere\",",
          "1434:         location=\"Earth\",  # TODO Ignoed by pypsa check",
          "1435:         carrier=\"co2\",",
          "1436:     )",
          "1437: ",
          "1438:     # can also be negative",
          "1439:     n.add(",
          "1440:         \"Store\",",
          "1441:         \"co2 atmosphere\",",
          "1442:         e_nom_extendable=True,",
          "1443:         e_min_pu=-1,",
          "1444:         carrier=\"co2\",",
          "1445:         bus=\"co2 atmosphere\",",
          "1446:     )",
          "1447: ",
          "1448:     # this tracks CO2 stored, e.g. underground",
          "1449:     n.madd(",
          "1450:         \"Bus\",",
          "1451:         spatial.co2.nodes,",
          "1452:         location=spatial.co2.locations,",
          "1453:         carrier=\"co2 stored\",",
          "1454:         # x=spatial.co2.x[0],",
          "1455:         # y=spatial.co2.y[0],",
          "1456:     )",
          "1457:     \"\"\"",
          "1458:     co2_stored_x = n.buses.filter(like=\"co2 stored\", axis=0).loc[:, \"x\"]",
          "1459:     co2_stored_y = n.buses.loc[n.buses[n.buses.carrier == \"co2",
          "1460:     stored\"].location].y.",
          "1461: ",
          "1462:     n.buses[n.buses.carrier == \"co2 stored\"].x = co2_stored_x.values",
          "1463:     n.buses[n.buses.carrier == \"co2 stored\"].y = co2_stored_y.values",
          "1464:     \"\"\"",
          "1465: ",
          "1466:     n.madd(",
          "1467:         \"Link\",",
          "1468:         spatial.co2.vents,",
          "1469:         bus0=spatial.co2.nodes,",
          "1470:         bus1=\"co2 atmosphere\",",
          "1471:         carrier=\"co2 vent\",",
          "1472:         efficiency=1.0,",
          "1473:         p_nom_extendable=True,",
          "1474:     )",
          "1475: ",
          "1476:     n.madd(",
          "1477:         \"Store\",",
          "1478:         spatial.co2.nodes,",
          "1479:         e_nom_extendable=True,",
