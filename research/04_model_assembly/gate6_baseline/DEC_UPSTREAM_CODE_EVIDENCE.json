          "149: def add_co2limit(n, annual_emissions, Nyears=1.0):",
          "150:     n.add(",
          "151:         \"GlobalConstraint\",",
          "152:         \"CO2Limit\",",
          "153:         carrier_attribute=\"co2_emissions\",",
          "154:         sense=\"<=\",",
          "155:         constant=annual_emissions * Nyears,",
          "156:     )",
          "157: ",
          "158: ",
          "159: def add_gaslimit(n, gaslimit, Nyears=1.0):",
          "160:     sel = n.carriers.index.intersection([\"OCGT\", \"CCGT\", \"CHP\"])",
          "161:     n.carriers.loc[sel, \"gas_usage\"] = 1.0",
          "162: ",
          "163:     n.add(",
          "164:         \"GlobalConstraint\",",
          "165:         \"GasLimit\",",
          "166:         carrier_attribute=\"gas_usage\",",
          "167:         sense=\"<=\",",
          "168:         constant=gaslimit * Nyears,",
          "169:     )",
          "170: ",
          "171: ",
          "172: def add_emission_prices(n, co2_price=0.0):",
          "173:     ep = (",
          "174:         pd.Series({\"co2_emissions\": co2_price}) * n.carriers.filter(like=\"_emissions\")",
          "175:     ).sum(axis=1)",
          "176:     gen_ep = n.generators.carrier.map(ep) / n.generators.efficiency"
        ]
      }
    ]
