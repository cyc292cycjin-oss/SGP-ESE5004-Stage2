          "3601: def add_co2_budget(",
          "3602:     n: pypsa.Network,",
          "3603:     co2: dict,",
          "3604:     investment_year: int,",
          "3605:     elec_opts: dict | None = None,",
          "3606: ) -> None:",
          "3607:     \"\"\"",
          "3608:     Add CO2 budget constraint to the network based on the specified co2_budget parameters.",
          "3609: ",
          "3610:     Parameters",
          "3611:     ----------",
          "3612:     n: pypsa.Network",
          "3613:         The PyPSA network to which the CO2 budget constraint will be added.",
          "3614:     co2: dict",
          "3615:         Dictionary containing CO2 budget parameters",
          "3616:     investment_year: int",
          "3617:         The year for which the CO2 budget constraint is being added",
          "3618:     elec_opts: dict",
          "3619:         Dictionary containing electricity options, used if co2base_value is 'co2limit' or 'co2base'",
          "3620: ",
          "3621:     Returns",
          "3622:     -------",
          "3623:     None",
          "3624:     \"\"\"",
          "3625: ",
          "3626:     budget = co2[\"budget\"]",
          "3627: ",
          "3628:     # Check if CO2Limit already exists",
          "3629:     if \"CO2Limit\" in n.global_constraints.index:",
          "3630:         if budget[\"override_co2opt\"]:",
          "3631:             logger.warning(\"CO2Limit already exists, value will be overwritten.\")",
          "3632:             n.global_constraints.drop(index=\"CO2Limit\", inplace=True)",
          "3633:         else:",
          "3634:             logger.info(\"CO2Limit already exists, value will not be overwritten.\")",
          "3635:             return",
          "3636: ",
          "3637:     # Get base year emission factor",
          "3638:     factor = (",
          "3639:         budget[\"year\"][investment_year] if investment_year in budget[\"year\"] else 1.0",
          "3640:     )",
          "3641: ",
          "3642:     base_value = budget[\"base_value\"]",
          "3643:     if base_value == \"limit\":",
          "3644:         annual_emissions = factor * co2[\"limit\"]",
          "3645:     elif base_value == \"base\":",
          "3646:         annual_emissions = factor * co2[\"base\"]",
          "3647:     elif base_value == \"absolute\":",
          "3648:         annual_emissions = factor",
          "3649:     elif isinstance(base_value, float):",
          "3650:         annual_emissions = factor * base_value",
          "3651:     else:",
          "3652:         raise ValueError(",
          "3653:             f\"co2.budget.base_value: '{base_value}' is not valid. \"",
          "3654:             \"Choose from: 'limit', 'base', 'absolute', or a float.\"",
          "3655:         )",
          "3656: ",
          "3657:     Nyears = n.snapshot_weightings.objective.sum() / 8760.0",
          "3658:     logger.info(",
          "3659:         f\"Annual emissions for {investment_year} set to {annual_emissions / 1e6:.2f} MtCO₂-eq/year.\"",
          "3660:     )",
          "3661: ",
          "3662:     add_co2limit(n, annual_emissions, Nyears)",
          "3663: ",
          "3664: ",
          "3665: def add_custom_water_cost(n: pypsa.Network) -> None:",
          "3666:     \"\"\"",
          "3667:     Add custom water cost to the network based on country-specific water cost data."
        ]
