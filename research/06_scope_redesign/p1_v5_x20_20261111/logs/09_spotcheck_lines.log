      meoh_per_tco2: stoichiometric       # V4 D2a (decision 220): stoichiometric (v4 main: methanolisation MWh_MeOH per t CO2 = M_MeOH / M_CO2 x LHV_MeOH = 4.0248, registry ammonia_methanol_MWh_MeOH_per_tCO2_stoichiomet
      lng_regas_adder: asean_tariffs      # V4 D2b (section 4.1): asean_tariffs (v4 main: registry v4_lng_regas_adder_asean_tariffs = median of the regulated LNG terminal tariffs TH ERC / MY ST / SG EMA-SLNG / ID Arun at
      source_band_basis: post_product     # V4 D2b (section 3, Fable F-02 side note): post_product (v4 main: source band shares of the fixed industrial biomass = cement-kiln biomass / T_v2 biomass after the product vecto
  biomass:                             # V4 D1 (decisions 212 item 5, 215 item 5): biomass pools whose registry cost is DATA_PENDING (s2_layers.add_biomass_layer)
    missing_cost_rule: null             # zero (v3.1: an empty cost column enters at 0) | proxy (registry biomass_missing_cost_proxy, the uniform proxy of unsourced residues); null = the switch-set value (v4.enabled fals
