export JOB_KEY=F2 JOB_NAME=hpr_f2 JOB_MODE=formal JOB_RID=F2 JOB_QUEUE=parallel JOB_NCPUS=48 JOB_MEM_GB=250 JOB_WALLTIME=257:00:00 JOB_TIME_LIMIT_S=864000 JOB_WALL_CAP_S=871200 JOB_LICENCE_GAP_S=330 JOB_WAIT_START_OF=F1 JOB_DEPENDS=after:F1
cd "${PBS_O_WORKDIR:?submit with qsub from the package folder (or set PBS_O_WORKDIR for the local drill)}" || exit 2
exec bash hpc/hpr_job.sh
