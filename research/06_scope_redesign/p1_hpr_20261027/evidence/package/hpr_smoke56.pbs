#!/bin/bash
#PBS -N hpr_smoke56
#PBS -q parallel
#PBS -l select=1:ncpus=17:mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -S /bin/bash
# HPR job script generated by hpc/make_pbs.sh at 2026-10-27T07:57:21Z from scripts_project/b4_batch4.py hpc-plan (RUN_PLAN_HPC.md sections 2-3, 9); package commit 9ff86cb6445c860c32c2d8d95b09789b89a6848a.
# Submit from the package folder on scratch (/hpctmp/<user>/hpr): the formal jobs through hpc/hpr_submit.sh (dependencies ), the test jobs with qsub pbs/hpr_smoke56.pbs.
# The licence is referenced only through GRB_LICENSE_FILE=$HOME/.gurobi/gurobi.lic (mode 600, placed by the user); never copied, printed or logged.
export JOB_KEY=smoke56 JOB_NAME=hpr_smoke56 JOB_MODE=smoke56 JOB_RID=all JOB_QUEUE=parallel JOB_NCPUS=17 JOB_MEM_GB=32 JOB_WALLTIME=04:00:00 JOB_TIME_LIMIT_S=864000 JOB_WALL_CAP_S=871200 JOB_LICENCE_GAP_S=330 JOB_WAIT_START_OF= JOB_DEPENDS=
cd "${PBS_O_WORKDIR:?submit with qsub from the package folder (or set PBS_O_WORKDIR for the local drill)}" || exit 2
# the smoke runs the three job bodies in sequence in one job: F1, F2 (56 snapshots each, >= 330 s apart), then the batch-level body (RUN_PLAN_HPC 9)
for rid in F1 F2 batch; do JOB_RID=$rid bash hpc/hpr_job.sh || exit $?; done
