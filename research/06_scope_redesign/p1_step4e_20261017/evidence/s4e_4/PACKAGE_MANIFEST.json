 "run": {
  "script": "run_365x24h.sh",
  "runs": [
   "integrated (STEPS)",
   "disconnected (STEPS, extra-ASEAN CO2 storage on, CO2 shipping and Lao transit kept)",
   "integrated_nze (NZE fuel prices)",
   "disconnected_gap (GAP_DIAGNOSTIC; only if the disconnected main ends non-optimal)"
  ],
  "example": "GRB_LICENSE_FILE=/path/to/gurobi.lic bash run_365x24h.sh --solver-profile formal_barrier --mode serial --auth '<user authorisation>'",
  "modes": [
   "serial",
   "lanes2",
   "lanes3"
  ],
  "solver_profile": "REQUIRED --solver-profile, no default; user-confirmed cloud profile A: formal_barrier",
  "kirchhoff_row_normalisation": "on (research.solver.scaling.kirchhoff_row_normalisation)",
  "scaling": "on",
  "exports_per_run": [
   "SOLVE_RECEIPT.json",
   "V5_GATES.json (incl. B1_BUNKERS, B16_LEDGER)",
   "COUNTRY_COST_LEDGER.csv",
   "COUNTRY_COST_LEDGER_DETAIL.csv",
   "LEDGER_IDENTITY.json",
   "NODAL_PRICES.csv",
   "CO2_FLOWS.json",
   "BUNKER_ACCOUNT.json",
   "solved network"
  ],
  "threads_per_run": 8,
  "wall_clock_cap_h": 3,
  "gurobi_time_limit_s": 10500,
  "licence": "GRB_LICENSE_FILE supplied by the user on the instance"
 },
 "first_batch_sensitivities_registered_not_packaged": [
  {
   "name": "extra-ASEAN CO2 storage price -50 % / +50 % (of 54.70 EUR2020/t)",
   "override": "co2.extra_asean_cost_scale=0.5 | 1.5",
   "scenarios": "integrated and disconnected"
  },
  {
   "name": "unified ZEP 2011 storage cost 16.05 EUR/t for every geological storage (national, intra-ASEAN receivers, extra-ASEAN 40.75)",
   "override": "s2.co2.sequestration_cost_eur_per_t=16.0535",
   "scenarios": "integrated and disconnected"
  },
  {
   "name": "CO2 shipping distance: single route factor 1.091 instead of the pair-specific sea path",
   "override": "co2.ship_distance=route_factor",
   "scenarios": "integrated and disconnected"
  },
  {
   "name": "Lao transit: nearest existing sea port and / or truck",
   "override": "co2.lao_transit_destination=existing_port ; co2.lao_transit_mode=truck",
   "scenarios": "integrated and disconnected"
  },
  {
   "name": "LNG terminal expansion without cap, cost only (7,018 EUR/MW/a)",
   "override": "s3.gas.lng_expansion=uncapped_cost",
   "scenarios": "integrated and disconnected"
  }
 ],
 "coalition_run_rule": "decision 95 f: a coalition run non-optimal with profile A is re-run once with profile C (barrier_numericfocus2); still non-optimal -> UNVERIFIED"
